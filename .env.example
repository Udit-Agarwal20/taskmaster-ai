# ============================================================
# Taskmaster Local Development
# ============================================================

# PostgreSQL persistence
# Example:
# postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# ============================================================
# Gemini / Vertex AI
# ============================================================

# Local fallback authentication (optional when using Vertex AI)
GEMINI_API_KEY=

# Production / Google Cloud inference
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
TASKMASTER_MODEL=gemini-3.5-flash

# ============================================================
# GitHub
# ============================================================

GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_REPOSITORY=your-org/your-repo
GITHUB_PROJECT_ID=student-marketplace

# ============================================================
# Slack
# ============================================================

SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_CHANNEL_ID=your_slack_channel_id

# ============================================================
# Google Cloud Pub/Sub
# ============================================================

TASKMASTER_EVENT_TOPIC=taskmaster-events
TASKMASTER_EVENT_SUBSCRIPTION=taskmaster-event-worker
PUBSUB_INVOKER_SERVICE_ACCOUNT=your-pubsub-invoker-service-account

# ============================================================
# Demo / Safety
# ============================================================

DEMO_OPERATOR_ID=user-udit
MAX_AUTO_ACTIONS_PER_RUN=5