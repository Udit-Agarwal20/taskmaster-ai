# PostgreSQL connection string (Required for Taskmaster persistence)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# DATABASE_URL=literal:postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Google Gemini API Key (Required for Gemini 3.5 Flash Agent Foundation)
# GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Integration Webhook (Milestone 4A & 4B)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_REPOSITORY=your-org/your-repo
GITHUB_PROJECT_ID=student-marketplace

# Slack App Integration (Milestone 4D - Verified Action Sink)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_CHANNEL_ID=C0123456789

# Server-Controlled Demo Operator Identity (Milestone 3C)
DEMO_OPERATOR_ID=user-udit
MAX_AUTO_ACTIONS_PER_RUN=5